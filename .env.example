APP_NAME="Sistem Internal Sales"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Sales_system/public
APP_TIMEZONE=Asia/Jakarta

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sales_system
