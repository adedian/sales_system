APP_NAME="Sistem Internal Sales"
APP_ENV=production
APP_DEBUG=false
APP_URL=__APP_URL__
APP_TIMEZONE=Asia/Jakarta

DB_HOST=__DB_HOST__
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PASS__

SESSION_NAME=sales_system_session
SESSION_LIFETIME=120

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

DASHBOARD_POLL_INTERVAL_MS=30000

REMEMBER_LIFETIME_DAYS=30
REMEMBER_COOKIE_NAME=sales_system_remember

# Dinonaktifkan di hosting gratis (outbound dibatasi). Isi hanya bila sudah dites.
ANTHROPIC_API_KEY=
AI_PROPOSAL_MODEL=claude-opus-5-5

# Generator PDF PLTS butuh Python + proc_open: tidak tersedia di InfinityFree.
PYTHON_BIN=python
